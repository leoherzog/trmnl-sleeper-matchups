{% comment %} Global trophy icon (FontAwesome) - sized via trophy_class param; image--adaptive repaints for dark mode/themes {% endcomment %}
{% template trophy_icon %}
{% assign trophy_class = trophy_class | default: 'w--6 h--6' %}
<img class="image image--adaptive {{ trophy_class }}" src="data:image/svg+xml;base64," />
{% endtemplate %}

{% comment %} ================================================================
SHARED COMPONENTS
================================================================ {% endcomment %}

{% template title_bar %}
{% comment %}
Parameters:
- sleeper: resolved data
- layout_size: 'team' (shows configured team) or 'week' (shows week/round)
{% endcomment %}
{% assign layout_size = layout_size | default: 'team' %}

<div class="title_bar">
  {% if sleeper.league.avatar %}
  <img class="image image-stroke rounded--full" src="https://sleepercdn.com/uploads/{{ sleeper.league.avatar }}" />
  {% else %}
  {% render 'sleeper_logo' %}
  {% endif %}

  <span class="title">{{ sleeper.league.name }}</span>

  {% if layout_size == 'week' %}
    {% if sleeper.view == 'pre_season' %}
      <span class="instance">Pre-Season</span>
    {% elsif sleeper.view == 'matchup' or sleeper.view == 'status' %}
      {% if sleeper.is_playoffs %}
      <span class="instance">{% if sleeper.bracket_type %}{{ sleeper.bracket_type }} {% endif %}Round {{ sleeper.playoff_round }}</span>
      {% else %}
      <span class="instance">Week {{ sleeper.week }}</span>
      {% endif %}
    {% endif %}
  {% elsif layout_size == 'team' and sleeper.my_team %}
    <span class="instance">{{ sleeper.my_team.team_name }}</span>
    {% render 'render_avatar', avatar_url: sleeper.my_team.avatar, title_bar: true %}
  {% endif %}
</div>
{% endtemplate %}

{% template render_avatar %}
{% comment %}
Avatar image with Sleeper-logo fallback
- avatar_url: image URL (may be null)
- title_bar: true for the title bar (default size), false for w--12 h--12
{% endcomment %}
{% assign title_bar = title_bar | default: false %}
{% if avatar_url == nil or avatar_url == '' or avatar_url == blank %}
  {% if title_bar %}
  <div class="hidden sm:inline">{% render 'sleeper_logo' %}</div>
  {% else %}
  <div class="w--12 h--12">{% render 'sleeper_logo' %}</div>
  {% endif %}
{% else %}
  {% if title_bar %}
  <img class="image image-stroke rounded--full" src="{{ avatar_url }}" />
  {% else %}
  <img class="image image-stroke image-dither rounded--full w--12 h--12" src="{{ avatar_url }}" />
  {% endif %}
{% endif %}
{% endtemplate %}

{% template record_pills %}
{% comment %}
Win/loss record as pills
- record: string of W/L characters
- size: label size; lg_class: optional ' lg:label--*' responsive class
- alignment: left or right
{% endcomment %}
{% assign size = size | default: 'small' %}
{% assign lg_class = lg_class | default: '' %}
{% assign alignment = alignment | default: 'left' %}
{% if record and record != '' %}
<div class="flex gap--xsmall {% if alignment == 'right' %}flex--right{% endif %}">
  {% assign record_chars = record | split: '' %}
  {% for char in record_chars %}
  {% if char == 'W' %}
  <span class="label label--{{ size }}{{ lg_class }} label--outline">W</span>
  {% elsif char == 'L' %}
  <span class="label label--{{ size }}{{ lg_class }} label--inverted">L</span>
  {% endif %}
  {% endfor %}
</div>
{% endif %}
{% endtemplate %}

{% comment %}
Per-layout size table used by the templates below:
  quadrant:        p--2, title/value/label small, no lg: bump
  half-*:          p--3 lg:p--4, small → lg: base
  full (default):  p--4 lg:p--6, base/base/small → lg: large/large/base
{% endcomment %}

{% comment %} ================================================================
PRE-SEASON
================================================================ {% endcomment %}

{% template pre_season_card %}
{% case layout_size %}
{% when 'quadrant' %}
{% assign lg_pre_title = '' %}
{% when 'half-horizontal', 'half-vertical' %}
{% assign lg_pre_title = ' lg:title--base' %}
{% else %}
{% assign lg_pre_title = ' lg:title--large' %}
{% endcase %}

<div class="flex flex--center-x flex--center-y w--full h--full">
  <div class="text--center">
    {% if sleeper.season_start_date %}
      <span class="title title--small{{ lg_pre_title }}">Week 1 of the NFL season starts {{ sleeper.season_start_date | l_date: '%B %-d, %Y', trmnl.user.locale }}</span>
    {% else %}
      <span class="title title--small{{ lg_pre_title }}">{{ sleeper.league.name }} is in pre-season</span>
    {% endif %}
  </div>
</div>
{% endtemplate %}

{% comment %} ================================================================
IN-SEASON
================================================================ {% endcomment %}

{% template matchup_card %}
{% comment %}
One team's card
- team: { team_name, username, avatar, record, wins, losses, score }
- alignment: 'left' or 'right'
- layout_size
{% endcomment %}
{% assign layout_size = layout_size | default: 'full' %}
{% case layout_size %}
{% when 'quadrant' %}
{% assign title_size = 'small' %}
{% assign value_size = 'small' %}
{% assign label_size = 'small' %}
{% assign padding = 'p--2' %}
{% assign lg_title = '' %}
{% assign lg_value = '' %}
{% assign lg_label = '' %}
{% when 'half-horizontal', 'half-vertical' %}
{% assign title_size = 'small' %}
{% assign value_size = 'small' %}
{% assign label_size = 'small' %}
{% assign padding = 'p--3 lg:p--4' %}
{% assign lg_title = ' lg:title--base' %}
{% assign lg_value = ' lg:value--base' %}
{% assign lg_label = ' lg:label--base' %}
{% else %}
{% assign title_size = 'base' %}
{% assign value_size = 'base' %}
{% assign label_size = 'small' %}
{% assign padding = 'p--4 lg:p--6' %}
{% assign lg_title = ' lg:title--large' %}
{% assign lg_value = ' lg:value--large' %}
{% assign lg_label = ' lg:label--base' %}
{% endcase %}

{% assign alignment = alignment | default: 'left' %}
{% if alignment == 'right' %}
{% assign text_align = 'text--right' %}
{% assign flex_dir = 'flex--row-reverse' %}
{% assign order_label = 'order--2' %}
{% assign order_value = 'order--1' %}
{% assign flex_align = 'flex--right' %}
{% assign score_align = 'flex--end' %}
{% else %}
{% assign text_align = 'text--left' %}
{% assign flex_dir = '' %}
{% assign order_label = '' %}
{% assign order_value = '' %}
{% assign flex_align = 'flex--start' %}
{% assign score_align = 'flex--start' %}
{% endif %}

<div class="bg--white rounded {{ padding }} stretch-x">
  {% if layout_size == 'quadrant' %}
    <div class="{{ text_align }}">
      <div class="title title--{{ title_size }}">{{ team.team_name }}</div>
      <div class="label label--{{ label_size }}">@{{ team.username }}</div>
      <div class="value value--{{ value_size }} mt--2">{{ team.score }}</div>
    </div>
  {% else %}
    <div class="flex flex--between flex--center-y {{ flex_dir }} mb--4">
      <div class="stretch-x {{ text_align }}">
        <div class="title title--{{ title_size }}{{ lg_title }}">{{ team.team_name }}</div>
        <div class="label label--{{ label_size }}{{ lg_label }}">@{{ team.username }}{% if team.wins != nil %} <span class="label label--{{ label_size }}{{ lg_label }} label--outline ml--1">{{ team.wins }}-{{ team.losses }}</span>{% endif %}</div>
      </div>
      {% render 'render_avatar', avatar_url: team.avatar, title_bar: false %}
    </div>

    <div class="flex flex--row gap--xsmall {{ flex_align }} mb--4">
      {% render 'record_pills', record: team.record, size: label_size, lg_class: lg_label, alignment: alignment %}
    </div>

    <div class="flex flex--row {{ score_align }} gap--medium">
      <span class="label label--{{ label_size }}{{ lg_label }} {{ order_label }}">Score</span>
      <span class="value value--{{ value_size }}{{ lg_value }} {{ order_value }}">{{ team.score }}</span>
    </div>
  {% endif %}
</div>
{% endtemplate %}

{% template status_card %}
{% comment %}
Centered card for bye / awaiting opponent / eliminated
- team_name, text, layout_size
{% endcomment %}
{% case layout_size %}
{% when 'quadrant' %}
{% assign padding = 'p--2' %}
{% assign title_class = 'title--small' %}
{% assign label_class = 'label--small' %}
{% when 'half-horizontal', 'half-vertical' %}
{% assign padding = 'p--3 lg:p--4' %}
{% else %}
{% assign padding = 'p--4 lg:p--6' %}
{% endcase %}
{% assign title_class = title_class | default: 'title--large lg:title--xlarge' %}
{% assign label_class = label_class | default: 'label--small lg:label--base' %}

<div class="bg--white rounded {{ padding }} stretch-x">
  <div class="flex flex--col flex--center-x flex--center-y h--full">
    <div class="text--center">
      <div class="label {{ label_class }} mb--2">{{ team_name }}</div>
      <div class="title {{ title_class }}">{{ text }}</div>
    </div>
  </div>
</div>
{% endtemplate %}

{% template vs_divider %}
{% comment %}
Divider between the two cards: "vs" + week, or trophy + bracket/round in playoffs
- sleeper, layout_size
{% endcomment %}
{% if layout_size == 'quadrant' %}
<div class="flex flex--center-x flex--center-y">
  <span class="label label--small flex flex--center-y gap--xsmall">{% if sleeper.is_playoffs %}{% render 'trophy_icon', trophy_class: 'w--4 h--4' %}{% else %}vs.{% endif %}</span>
</div>
{% elsif layout_size == 'half-vertical' %}
<div class="flex flex--center-x flex--center-y">
  {% if sleeper.is_playoffs %}
  <span class="label label--small flex flex--center-y gap--xsmall">{% render 'trophy_icon', trophy_class: 'w--4 h--4' %}<span>{% if sleeper.bracket_type %}{{ sleeper.bracket_type }} {% endif %}Round {{ sleeper.playoff_round }}</span></span>
  {% else %}
  <span class="label label--small">vs • Week {{ sleeper.week }}</span>
  {% endif %}
</div>
{% else %}
<div class="flex flex--col flex--center-x flex--center-y no-shrink">
  {% if sleeper.is_playoffs %}
  <div class="title title--small">{% render 'trophy_icon', trophy_class: 'w--8 h--8' %}</div>
  {% if sleeper.bracket_type %}<div class="label label--small">{{ sleeper.bracket_type }}</div>{% endif %}
  <div class="label label--small">Round {{ sleeper.playoff_round }}</div>
  {% else %}
  <div class="label label--small">vs</div>
  <div class="label label--small">Week {{ sleeper.week }}</div>
  {% endif %}
</div>
{% endif %}
{% endtemplate %}

{% template matchup_display %}
{% comment %}
Gray panel holding the matchup (or status) cards
- sleeper, layout_size
{% endcomment %}
{% assign layout_size = layout_size | default: 'full' %}
{% case layout_size %}
{% when 'quadrant' %}
{% assign padding = 'p--2' %}
{% assign gap_size = 'small' %}
{% when 'half-horizontal', 'half-vertical' %}
{% assign padding = 'p--3 lg:p--4' %}
{% assign gap_size = 'medium' %}
{% else %}
{% assign padding = 'p--4 lg:p--6' %}
{% assign gap_size = 'medium' %}
{% endcase %}
{% if layout_size == 'half-vertical' %}
{% assign direction = 'col' %}
{% else %}
{% assign direction = 'row' %}
{% endif %}

<div class="layout layout--{{ direction }} layout--stretch-y bg--gray-70 {{ padding }} rounded--medium">
  <div class="flex flex--{{ direction }} gap--{{ gap_size }} w--full">
    {% if sleeper.view == 'status' %}
      {% render 'status_card', team_name: sleeper.team1.team_name, text: sleeper.status_text, layout_size: layout_size %}
    {% else %}
      {% render 'matchup_card', team: sleeper.team1, alignment: 'left', layout_size: layout_size %}
      {% if sleeper.team2 %}
        {% render 'vs_divider', sleeper: sleeper, layout_size: layout_size %}
        {% render 'matchup_card', team: sleeper.team2, alignment: 'right', layout_size: layout_size %}
      {% endif %}
    {% endif %}
  </div>
</div>
{% endtemplate %}

{% comment %} ================================================================
SEASON COMPLETE
================================================================ {% endcomment %}

{% template season_complete_card %}
{% assign layout_size = layout_size | default: 'full' %}
{% case layout_size %}
{% when 'quadrant' %}
{% assign trophy_svg_size = 'w--10 h--10' %}
{% assign spacing_class = 'mb--2' %}
{% assign lg_winner_title = '' %}
{% when 'half-horizontal' %}
{% assign trophy_svg_size = 'w--12 h--12' %}
{% assign spacing_class = 'mb--4' %}
{% assign lg_winner_title = ' lg:title--base' %}
{% else %}
{% assign trophy_svg_size = 'w--16 h--16' %}
{% assign spacing_class = 'mb--8' %}
{% assign lg_winner_title = ' lg:title--base' %}
{% endcase %}

<div class="flex flex--center-x flex--center-y w--full h--full">
  <div class="text--center">
    {% if sleeper.winner %}
    <div class="{{ spacing_class }} flex flex--center-x">
      {% render 'trophy_icon', trophy_class: trophy_svg_size %}
    </div>
    <div class="{{ spacing_class }}">
      <span class="title title--small{{ lg_winner_title }}">The {{ sleeper.league.season }} winner of {{ sleeper.league.name }} is</span>
    </div>
    <div class="flex flex--col flex--center-x flex--center-y gap--medium">
      {% render 'render_avatar', avatar_url: sleeper.winner.avatar, title_bar: false %}
      <div class="text--center">
        <div class="title title--base lg:title--large">{{ sleeper.winner.team_name }}</div>
        <div class="label label--small lg:label--base">@{{ sleeper.winner.username }}</div>
      </div>
    </div>
    {% else %}
    <span class="label label--small">Winner data unavailable</span>
    {% endif %}
  </div>
</div>
{% endtemplate %}

{% comment %} ================================================================
MAIN CONTENT — routes on sleeper.view
================================================================ {% endcomment %}

{% template main_content %}
{% comment %}
- sleeper: resolved data from serverless.js
- trmnl: TRMNL globals (user locale)
- layout_size: 'full', 'half-horizontal', 'half-vertical', or 'quadrant'
{% endcomment %}
{% assign layout_size = layout_size | default: 'full' %}

{% case sleeper.view %}
{% when 'pre_season' %}
  {% render 'pre_season_card', sleeper: sleeper, trmnl: trmnl, layout_size: layout_size %}
{% when 'matchup', 'status' %}
  {% render 'matchup_display', sleeper: sleeper, layout_size: layout_size %}
{% when 'winner' %}
  {% render 'season_complete_card', sleeper: sleeper, layout_size: layout_size %}
{% else %}
  <div class="flex flex--center-x flex--center-y w--full h--full">
    <div class="text--center">
      <span class="label label--small">{% if sleeper.error %}Sleeper data unavailable: {{ sleeper.error }}{% else %}No Sleeper data yet — check the plugin's League ID{% endif %}</span>
    </div>
  </div>
{% endcase %}
{% endtemplate %}
