{% comment %} Global trophy icon (FontAwesome) - sized via trophy_class param; image--adaptive repaints for dark mode/themes {% endcomment %}
{% template trophy_icon %}
{% assign trophy_class = trophy_class | default: 'w--6 h--6' %}
<img class="image image--adaptive {{ trophy_class }}" src="data:image/svg+xml;base64," />
{% endtemplate %}

{% comment %} ================================================================
SHARED COMPONENTS
================================================================ {% endcomment %}

{% template title_bar %}
{% comment %}
Parameters:
- sleeper: resolved data
- layout_size: 'team' (shows configured team) or 'week' (shows week/round)
{% endcomment %}
{% assign layout_size = layout_size | default: 'team' %}

<div class="title_bar">
  {% if sleeper.league.avatar %}
  <img class="image image-stroke rounded--full" src="https://sleepercdn.com/uploads/{{ sleeper.league.avatar }}" />
  {% else %}
  {% render 'sleeper_logo' %}
  {% endif %}

  <span class="title">{{ sleeper.league.name }}</span>

  {% if layout_size == 'week' %}
    {% if sleeper.view == 'pre_season' %}
      <span class="instance" data-clamp="1">Pre-Season</span>
    {% elsif sleeper.view == 'matchup' or sleeper.view == 'status' %}
      {% if sleeper.is_playoffs %}
      <span class="instance" data-clamp="1">{% if sleeper.bracket_type %}{{ sleeper.bracket_type }} {% endif %}Round {{ sleeper.playoff_round }}</span>
      {% else %}
      <span class="instance" data-clamp="1">Week {{ sleeper.week }}</span>
      {% endif %}
    {% endif %}
  {% elsif layout_size == 'team' and sleeper.my_team %}
    <span class="instance" data-clamp="1">{{ sleeper.my_team.team_name }}</span>
    {% render 'render_avatar', avatar_url: sleeper.my_team.avatar, title_bar: true %}
  {% endif %}
</div>
{% endtemplate %}

{% template render_avatar %}
{% comment %}
Avatar image with Sleeper-logo fallback
- avatar_url: image URL (may be null)
- title_bar: true for the title bar (default size), false for w--12 h--12
{% endcomment %}
{% assign title_bar = title_bar | default: false %}
{% if avatar_url == nil or avatar_url == '' or avatar_url == blank %}
  {% if title_bar %}
  <div class="hidden sm:inline">{% render 'sleeper_logo' %}</div>
  {% else %}
  <div class="w--12 h--12">{% render 'sleeper_logo' %}</div>
  {% endif %}
{% else %}
  {% if title_bar %}
  <img class="image image-stroke rounded--full" src="{{ avatar_url }}" />
  {% else %}
  <img class="image image-stroke image-dither rounded--full w--12 h--12" src="{{ avatar_url }}" />
  {% endif %}
{% endif %}
{% endtemplate %}

{% template record_pills %}
{% comment %}
Win/loss record as pills
- record: string of W/L characters
- size: label size; lg_class: optional ' lg:label--*' responsive class
- alignment: left or right
{% endcomment %}
{% assign size = size | default: 'small' %}
{% assign lg_class = lg_class | default: '' %}
{% assign alignment = alignment | default: 'left' %}
{% if record and record != '' %}
<div class="flex gap--xsmall {% if alignment == 'right' %}flex--right{% endif %}">
  {% assign record_chars = record | split: '' %}
  {% for char in record_chars %}
  {% if char == 'W' %}
  <span class="label label--{{ size }}{{ lg_class }} label--outline">W</span>
  {% elsif char == 'L' %}
  <span class="label label--{{ size }}{{ lg_class }} label--inverted">L</span>
  {% endif %}
  {% endfor %}
</div>
{% endif %}
{% endtemplate %}

{% comment %}
Per-layout size table used by the templates below:
  quadrant:        p--2, title/value/label small, no lg: bump
  half-*:          p--3 lg:landscape:p--4, small -> lg: base
  full (default):  p--4 lg:landscape:p--6, base/base/small -> lg: large/large/base

The bump is `lg:landscape:`, never bare `lg:` — see ORIENTATION at the foot of
this file for why, and for the cascade trap that makes bare `lg:` unfixable.
{% endcomment %}

{% comment %} ================================================================
PRE-SEASON
================================================================ {% endcomment %}

{% template pre_season_card %}
{% case layout_size %}
{% when 'quadrant' %}
{% assign lg_pre_title = '' %}
{% when 'half-horizontal', 'half-vertical' %}
{% assign lg_pre_title = ' lg:landscape:title--base' %}
{% else %}
{% assign lg_pre_title = ' lg:landscape:title--large' %}
{% endcase %}

<div class="layout">
  <div class="flex flex--center-x flex--center-y w--full h--full">
    <div class="text--center">
    {% if sleeper.season_start_date %}
      <span class="title title--small{{ lg_pre_title }}">Week 1 of the NFL season starts {{ sleeper.season_start_date | l_date: '%B %-d, %Y', trmnl.user.locale }}</span>
    {% else %}
      <span class="title title--small{{ lg_pre_title }}">{{ sleeper.league.name }} is in pre-season</span>
    {% endif %}
    </div>
  </div>
</div>
{% endtemplate %}

{% comment %} ================================================================
IN-SEASON
================================================================ {% endcomment %}

{% template matchup_card %}
{% comment %}
One team's card
- team: { team_name, username, avatar, record, wins, losses, score, projected } (projected may be null)
- alignment: 'left' or 'right'
- layout_size
{% endcomment %}
{% assign layout_size = layout_size | default: 'full' %}
{% case layout_size %}
{% when 'quadrant' %}
{% assign title_size = 'small' %}
{% assign value_size = 'small' %}
{% assign label_size = 'small' %}
{% assign padding = 'p--2' %}
{% assign lg_title = '' %}
{% assign lg_value = '' %}
{% assign lg_label = '' %}
{% when 'half-horizontal', 'half-vertical' %}
{% assign title_size = 'small' %}
{% assign value_size = 'small' %}
{% assign label_size = 'small' %}
{% assign padding = 'p--3 lg:landscape:p--4' %}
{% assign lg_title = ' lg:landscape:title--base' %}
{% assign lg_value = ' lg:landscape:value--base' %}
{% assign lg_label = ' lg:landscape:label--base' %}
{% else %}
{% assign title_size = 'base' %}
{% assign value_size = 'base' %}
{% assign label_size = 'small' %}
{% assign padding = 'p--4 lg:landscape:p--6' %}
{% assign lg_title = ' lg:landscape:title--large' %}
{% assign lg_value = ' lg:landscape:value--large' %}
{% assign lg_label = ' lg:landscape:label--base' %}
{% endcase %}

{% comment %}
The W/L pills are the first thing to go when space runs out: the same record is
already on the username line as "8-5". Stacked portrait half-horizontal is the
only box too short to hold them (two full cards need ~396px of a 353px layout).
{% endcomment %}
{% if layout_size == 'half-horizontal' %}
{% assign pills_class = ' portrait:hidden' %}
{% else %}
{% assign pills_class = '' %}
{% endif %}

{% assign alignment = alignment | default: 'left' %}
{% if alignment == 'right' %}
{% assign text_align = 'text--right' %}
{% assign flex_dir = 'flex--row-reverse' %}
{% assign order_label = 'order--2' %}
{% assign order_value = 'order--1' %}
{% assign flex_align = 'flex--right' %}
{% assign score_align = 'flex--end' %}
{% else %}
{% assign text_align = 'text--left' %}
{% assign flex_dir = '' %}
{% assign order_label = '' %}
{% assign order_value = '' %}
{% assign flex_align = 'flex--start' %}
{% assign score_align = 'flex--start' %}
{% endif %}

<div class="bg--white rounded {{ padding }} stretch-x">
  {% if layout_size == 'quadrant' %}
    <div class="{{ text_align }}">
      <div class="title title--{{ title_size }}" data-clamp="2">{{ team.team_name }}</div>
      <div class="label label--{{ label_size }}" data-clamp="1">@{{ team.username }}</div>
      <div class="value value--{{ value_size }} value--tnums mt--2" data-fit-value="true">{{ team.score }}</div>
      {% if team.projected %}<div class="label label--{{ label_size }} label--gray-40">Proj {{ team.projected }}</div>{% endif %}
    </div>
  {% else %}
    <div class="flex flex--between flex--center-y {{ flex_dir }} mb--4">
      <div class="stretch-x {{ text_align }}">
        <div class="title title--{{ title_size }}{{ lg_title }}" data-clamp="2">{{ team.team_name }}</div>
        <div class="label label--{{ label_size }}{{ lg_label }}">@{{ team.username }}{% if team.wins != nil %} <span class="label label--{{ label_size }}{{ lg_label }} label--outline ml--1">{{ team.wins }}-{{ team.losses }}</span>{% endif %}</div>
      </div>
      {% render 'render_avatar', avatar_url: team.avatar, title_bar: false %}
    </div>

    {% if team.record != blank %}
    <div class="flex flex--row gap--xsmall {{ flex_align }} mb--4{{ pills_class }}">
      {% render 'record_pills', record: team.record, size: label_size, lg_class: lg_label, alignment: alignment %}
    </div>
    {% endif %}

    <div class="flex flex--row {{ score_align }} flex--center-y gap--medium">
      <div class="flex flex--col {{ text_align }} {{ order_label }}">
        <span class="label label--{{ label_size }}{{ lg_label }}">Score</span>
        <span class="value value--{{ value_size }}{{ lg_value }} value--tnums" data-fit-value="true">{{ team.score }}</span>
      </div>
      {% if team.projected %}
      <div class="flex flex--col {{ text_align }} {{ order_value }}">
        <span class="label label--{{ label_size }}{{ lg_label }} label--gray-40">Proj</span>
        <span class="value value--xsmall{{ lg_label | replace: 'label', 'value' }} value--tnums" data-fit-value="true">{{ team.projected }}</span>
      </div>
      {% endif %}
    </div>
  {% endif %}
</div>
{% endtemplate %}

{% template status_card %}
{% comment %}
Centered card for bye / awaiting opponent / eliminated
- team_name, text, layout_size
{% endcomment %}
{% case layout_size %}
{% when 'quadrant' %}
{% assign padding = 'p--2' %}
{% assign title_class = 'title--small' %}
{% assign label_class = 'label--small' %}
{% when 'half-horizontal', 'half-vertical' %}
{% assign padding = 'p--3 lg:landscape:p--4' %}
{% assign title_class = 'title--base lg:landscape:title--large' %}
{% assign label_class = 'label--small lg:landscape:label--base' %}
{% else %}
{% assign padding = 'p--4 lg:landscape:p--6' %}
{% assign title_class = 'title--large lg:landscape:title--xlarge' %}
{% assign label_class = 'label--small lg:landscape:label--base' %}
{% endcase %}

<div class="bg--white rounded {{ padding }} stretch-x">
  <div class="flex flex--col flex--center-x flex--center-y h--full">
    <div class="text--center">
      <div class="label {{ label_class }} mb--2" data-clamp="1">{{ team_name }}</div>
      <div class="title {{ title_class }}">{{ text }}</div>
    </div>
  </div>
</div>
{% endtemplate %}

{% template vs_divider %}
{% comment %}
Divider between the two cards: "vs" + week, or trophy + bracket/round in playoffs
- sleeper, layout_size
{% endcomment %}
{% if layout_size == 'quadrant' %}
<div class="flex flex--center-x flex--center-y no-shrink">
  <span class="label label--small flex flex--center-y gap--xsmall">{% if sleeper.is_playoffs %}{% render 'trophy_icon', trophy_class: 'w--4 h--4' %}{% else %}vs.{% endif %}</span>
</div>
{% else %}
{% comment %}
The divider runs perpendicular to the card stack: stacked lines while the cards
sit side by side, a single inline row once they stack. So it stays compact on
whichever axis is scarce.
{% endcomment %}
{% if layout_size == 'half-vertical' %}
{% assign divider_dir = 'flex--row' %}
{% assign divider_trophy = 'w--4 h--4' %}
{% else %}
{% assign divider_dir = 'flex--col portrait:flex--row' %}
{% assign divider_trophy = 'w--8 h--8' %}
{% endif %}
<div class="flex {{ divider_dir }} flex--center-x flex--center-y no-shrink">
  {% if sleeper.is_playoffs %}
  {% render 'trophy_icon', trophy_class: divider_trophy %}
  {% if sleeper.bracket_type %}<span class="label label--small">{{ sleeper.bracket_type }}</span>{% endif %}
  <span class="label label--small">Round {{ sleeper.playoff_round }}</span>
  {% else %}
  <span class="label label--small">vs</span>
  <span class="label label--small">Week {{ sleeper.week }}</span>
  {% endif %}
</div>
{% endif %}
{% endtemplate %}

{% template matchup_display %}
{% comment %}
Gray panel holding the matchup (or status) cards
- sleeper, layout_size
{% endcomment %}
{% assign layout_size = layout_size | default: 'full' %}
{% case layout_size %}
{% when 'quadrant' %}
{% assign padding = 'p--2' %}
{% assign gap_class = 'gap--small' %}
{% when 'half-horizontal' %}
{% comment %} Stacking costs height, and portrait half-horizontal has the least
of it (460x385 -> 353px of layout). Tighten the gap there only. {% endcomment %}
{% assign padding = 'p--3 lg:landscape:p--4' %}
{% assign gap_class = 'gap--medium portrait:gap--small' %}
{% when 'half-vertical' %}
{% assign padding = 'p--3 lg:landscape:p--4' %}
{% assign gap_class = 'gap--medium' %}
{% else %}
{% assign padding = 'p--4 lg:landscape:p--6' %}
{% assign gap_class = 'gap--medium' %}
{% endcase %}
{% comment %}
Side by side only survives while the view is wide. half-vertical is narrow in
both orientations so it always stacks; the other three are wide in landscape and
narrow in portrait, so they stack via `portrait:`. See ORIENTATION at the foot
of this file.
{% endcomment %}
{% if layout_size == 'half-vertical' %}
{% assign layout_dir = 'layout--col' %}
{% assign flex_dir = 'flex--col' %}
{% else %}
{% assign layout_dir = 'layout--row portrait:layout--col' %}
{% assign flex_dir = 'flex--row portrait:flex--col' %}
{% endif %}

<div class="layout {{ layout_dir }} layout--stretch-y bg--gray-70 {{ padding }} rounded--medium">
  <div class="flex {{ flex_dir }} portrait:flex--center-y {{ gap_class }} w--full h--full">
    {% if sleeper.view == 'status' %}
      {% render 'status_card', team_name: sleeper.team1.team_name, text: sleeper.status_text, layout_size: layout_size %}
    {% else %}
      {% render 'matchup_card', team: sleeper.team1, alignment: 'left', layout_size: layout_size %}
      {% if sleeper.team2 %}
        {% render 'vs_divider', sleeper: sleeper, layout_size: layout_size %}
        {% render 'matchup_card', team: sleeper.team2, alignment: 'right', layout_size: layout_size %}
      {% endif %}
    {% endif %}
  </div>
</div>
{% endtemplate %}

{% comment %} ================================================================
SEASON COMPLETE
================================================================ {% endcomment %}

{% template season_complete_card %}
{% assign layout_size = layout_size | default: 'full' %}
{% case layout_size %}
{% when 'quadrant' %}
{% assign trophy_svg_size = 'w--10 h--10' %}
{% assign spacing_class = 'mb--2' %}
{% assign lg_winner_title = '' %}
{% when 'half-horizontal' %}
{% assign trophy_svg_size = 'w--10 h--10' %}
{% assign spacing_class = 'mb--2' %}
{% assign lg_winner_title = ' lg:landscape:title--base' %}
{% else %}
{% assign trophy_svg_size = 'w--16 h--16' %}
{% assign spacing_class = 'mb--8' %}
{% assign lg_winner_title = ' lg:landscape:title--base' %}
{% endcase %}

<div class="layout">
  <div class="flex flex--center-x flex--center-y w--full h--full">
    <div class="text--center">
    {% if sleeper.winner %}
    <div class="{{ spacing_class }} flex flex--center-x">
      {% render 'trophy_icon', trophy_class: trophy_svg_size %}
    </div>
    <div class="{{ spacing_class }}">
      <span class="title title--small{{ lg_winner_title }}">The {{ sleeper.league.season }} winner of {{ sleeper.league.name }} is</span>
    </div>
    <div class="flex flex--col flex--center-x flex--center-y gap--medium">
      {% render 'render_avatar', avatar_url: sleeper.winner.avatar, title_bar: false %}
      <div class="text--center">
        <div class="title title--base lg:landscape:title--large" data-clamp="2">{{ sleeper.winner.team_name }}</div>
        <div class="label label--small lg:landscape:label--base" data-clamp="1">@{{ sleeper.winner.username }}</div>
      </div>
    </div>
    {% else %}
    <span class="label label--small">Winner data unavailable</span>
    {% endif %}
    </div>
  </div>
</div>
{% endtemplate %}

{% comment %} ================================================================
MAIN CONTENT — routes on sleeper.view
================================================================ {% endcomment %}

{% template main_content %}
{% comment %}
- sleeper: resolved data from serverless.js
- trmnl: TRMNL globals (user locale)
- layout_size: 'full', 'half-horizontal', 'half-vertical', or 'quadrant'
{% endcomment %}
{% assign layout_size = layout_size | default: 'full' %}

{% case sleeper.view %}
{% when 'pre_season' %}
  {% render 'pre_season_card', sleeper: sleeper, trmnl: trmnl, layout_size: layout_size %}
{% when 'matchup', 'status' %}
  {% render 'matchup_display', sleeper: sleeper, layout_size: layout_size %}
{% when 'winner' %}
  {% render 'season_complete_card', sleeper: sleeper, layout_size: layout_size %}
{% else %}
  <div class="layout">
    <div class="flex flex--center-x flex--center-y w--full h--full">
      <div class="text--center">
        <span class="label label--small">{% if sleeper.error %}Sleeper data unavailable: {{ sleeper.error }}{% else %}No Sleeper data yet — check the plugin's League ID{% endif %}</span>
      </div>
    </div>
  </div>
{% endcase %}
{% endtemplate %}

{% comment %} ================================================================
ORIENTATION

A device set to Portrait (Device Settings > Color & Rotation) does not get a new
set of views — the framework just transposes the screen and every view size is
recomputed from it:

  .screen--portrait { --screen-w: var(--screen-h-original);
                      --screen-h: var(--screen-w-original); /* then re-derives
                      --full-*, --quadrant-*, --half_vertical-*, --half_horizontal-* */ }

So on an OG the boxes swap shape entirely (measured, gap 10px):

  view              landscape    portrait
  full              780 x 460    460 x 780
  half_horizontal   780 x 225    460 x 385
  half_vertical     385 x 460    225 x 780
  quadrant          385 x 225    225 x 385

Two consequences drive the markup:

1. `layout_size` stops predicting the shape. half_horizontal is no longer a
   banner and quadrant is no longer a postcard — in portrait all four views are
   taller than wide, so all four want a stacked axis. Liquid cannot know the
   orientation, so the axis is chosen in CSS: templates emit BOTH classes
   (`flex--row portrait:flex--col`) and let the framework pick. Stacking also
   hands each card the full width back — a portrait full card is 428px against
   337px in landscape — which is why nothing else has to shrink.

2. `lg:` keeps firing and makes it worse. screen--sm/md/lg are device-model
   aliases (the CSS groups `.screen--lg` with `.screen--v2` et al), not width
   queries, so rotation does not clear them: a V2/X in portrait is 760px wide
   and still takes every `lg:` bump meant for 1020px.

   The trap: a bare `portrait:` CANNOT undo a bare `lg:`. Both resolve to one
   class of specificity and `lg:` wins on source order (verified on v3.3.0
   across title/value/label). Only `lg:portrait:` outranks it. So every bump
   here is written `lg:landscape:` — opt-in per orientation, nothing to undo.

   No `lg:portrait:` bumps are needed: a rotated V2/X is ~760/375px wide, within
   3% of an OG in landscape (780/385), so dropping to the base scale in portrait
   lands on the scale already tuned for that width.
================================================================ {% endcomment %}

{% comment %} ================================================================
TITLE BAR FIT

The framework already encodes the priority we want: .title is `flex: 0 0 auto`
(never shrinks) and .instance is `flex: 1 1 auto; min-width: 0` (absorbs all of
the shrink). But both rules end in `overflow: visible` — needed so the pixel
text-stroke isn't clipped — which overrides their own `overflow: hidden` and so
defeats `text-overflow: ellipsis`. A squeezed .instance therefore spills its
text over the avatar instead of truncating.

`data-clamp="1"` on .instance restores the ellipsis (the clamp engine truncates
by character in JS, so overflow:visible doesn't defeat it).

This script covers the one case clamping can't: the league name ALONE needing
more than the whole bar. .title never shrinks, so the clamp engine measures its
natural width and finds nothing to trim. When that happens we drop the team name
outright on the narrow views — giving the league name the full bar — and mark
the title shrinkable so the clamp engine can then ellipsize it.

DOMContentLoaded fires before the framework's terminalize() pass (scheduled on
window load), so the clamp engine measures the layout this leaves behind.
================================================================ {% endcomment %}
<script>
(function () {
  // shared.liquid is emitted once per view, and a mashup renders several.
  if (window.__sleeperTitleBarFit) return;
  window.__sleeperTitleBarFit = true;

  // .instance is squeezed to a narrow box while its text paints past it, so
  // offsetWidth/scrollWidth report the box. Range measures the text itself.
  function textWidth(element) {
    var range = document.createRange();
    range.selectNodeContents(element);
    return range.getBoundingClientRect().width;
  }

  function fontSize(element) {
    return parseFloat(window.getComputedStyle(element).fontSize) || 16;
  }

  function fitTitleBars() {
    document.querySelectorAll('.title_bar').forEach(function (bar) {
      var title = bar.querySelector('.title');
      if (!title) return;
      var instance = bar.querySelector('.instance');

      var style = window.getComputedStyle(bar);
      var gap = parseFloat(style.columnGap || style.gap) || 0;
      var padding = (parseFloat(style.paddingLeft) || 0) + (parseFloat(style.paddingRight) || 0);
      var children = Array.prototype.slice.call(bar.children);
      var icons = children.reduce(function (sum, child) {
        return child === title || child === instance ? sum : sum + child.getBoundingClientRect().width;
      }, 0);
      var available = bar.clientWidth - padding - icons - gap * (children.length - 1);
      var titleWidth = textWidth(title);

      if (titleWidth <= available) {
        // The title fits, so .instance gets whatever is left over. Given only a
        // character or two the clamp engine can emit nothing but an ellipsis,
        // which reads as damage rather than as truncation — drop it instead.
        // Portrait halves the bar (225px on a quadrant), so this is where it
        // first bites. Otherwise leave it alone; the clamp handles the rest.
        var room = available - titleWidth;
        if (instance && room < Math.min(textWidth(instance), 3 * fontSize(instance))) {
          instance.classList.add('hidden');
        }
        return;
      }

      if (instance && bar.closest('.view--half_vertical, .view--quadrant')) {
        instance.classList.add('hidden');
      }
      title.classList.add('flex-initial');
      title.setAttribute('data-clamp', '1');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fitTitleBars);
  } else {
    fitTitleBars();
  }
})();
</script>
